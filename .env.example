DATABASE_URL=postgresql://user:password@host:5432/eval_mcp?sslmode=require
EVAL_MCP_API_KEY=replace-with-your-api-key
EVAL_MCP_API_KEYS=
LOG_LEVEL=INFO
ENVIRONMENT=production
QUEUE_BACKEND=database_polling
REDIS_URL=
REDIS_QUEUE_NAME=eval_mcp:runs
WORKER_POLL_INTERVAL_SECONDS=1.0
WORKER_MAX_RETRIES=2

STORAGE_PROVIDER=b2
LOCAL_ARTIFACT_DIRECTORY=./.artifacts
B2_BUCKET=your-bucket-name
B2_REGION=
B2_ENDPOINT_URL=https://s3.your-region.backblazeb2.com
B2_KEY_ID=your-b2-key-id
B2_APPLICATION_KEY=your-b2-application-key

DEFAULT_MODEL_PROVIDER=stub
DEFAULT_MODEL_NAME=stub-evaluator
GOOGLE_API_KEY=
GOOGLE_AI_STUDIO_API_KEY=your-google-ai-studio-api-key
GOOGLE_API_BASE=https://generativelanguage.googleapis.com

MODEL_REQUEST_TIMEOUT_SECONDS=60
JUDGE_REQUEST_TIMEOUT_SECONDS=60
USE_LIVE_DEEPEVAL=false
USE_LIVE_RAGAS=false

S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

MCP_TRANSPORT=stdio
API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8501

# Installable MCP client settings
EVAL_MCP_API_URL=https://eval-mcp.onrender.com
